generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model People {
  id              String    @id @default(uuid())
  nome            String    @db.VarChar(150)
  cpf             String    @unique @db.VarChar(11)
  dataNascimento  DateTime? @map("data_nascimento") @db.Date
  endereco        String?
  telefone        String?   @db.VarChar(20)
  pontoReferencia String?   @map("ponto_referencia")
  bairro          String?
  cidade          String?
  uf              String?   @db.VarChar(2)
  cep             String?   @db.VarChar(8)
  comunidade      String?
  localVotacao    String?   @map("local_votacao")
  tituloEleitor   String?   @map("titulo_eleitor")
  zona            String?   @db.VarChar(10)
  secao           String?   @db.VarChar(10)
  coordenador     String?
  facebook        String?
  instagram       String?
  obs             String?   @db.Text
  criadoEm        DateTime  @default(now()) @map("criado_em")

  // Relacionamento: Uma pessoa pode ter muitas demandas

  categorias        Category[]
  pessoaDemandaRuas PessoaDemandaRua[]

  @@map("pessoas")
}

model Category {
  id   String @id @default(uuid())
  nome String @unique

  pessoas People[]

  @@map("categorias")
}

model DemandStreet {
  id        String  @id @default(uuid())
  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  status StatusDemanda @default(PENDENTE)

  rua    String?
  bairro String?
  cidade String?
  uf     String? @db.VarChar(2)

  fotos String[] @default([])

  criadoEm DateTime @default(now()) @map("criado_em")

  solicitantes PessoaDemandaRua[]
  // people       People?            @relation(fields: [peopleId], references: [id])
  // peopleId     String?

  @@map("demandas")
}

model PessoaDemandaRua {
  pessoaId  String
  demandaId String

  pessoa  People       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  demanda DemandStreet @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  solicitadoEm DateTime @default(now())

  @@id([pessoaId, demandaId])
  @@map("pessoas_demandas")
}

enum StatusDemanda {
  PENDENTE
  EM_ANDAMENTO
  RESOLVIDO
  CANCELADO
}

